# Set this to the Laravel public URL reachable from the device (do not add /api).
# Laragon project-folder example; replace with your computer's LAN IP for Expo Go:
EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_LAN_IP/LittleStep/backend/public
# Android emulator alternative:
# EXPO_PUBLIC_API_URL=http://10.0.2.2/LittleStep/backend/public
