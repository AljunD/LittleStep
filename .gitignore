# Repository-wide ignores for LittleStep.
# backend/.gitignore and mobile/.gitignore hold the app-specific rules
# (vendor/, node_modules/, build output, Expo caches); this file is a safety
# net for secrets, personal data, and machine-specific files in any folder.

# ---- Environment files and secrets ----
.env
.env.*
!.env.example
auth.json
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
google-services.json
GoogleService-Info.plist

# ---- Databases and dumps (may contain children's personal data) ----
*.sqlite
*.sqlite3
*.db
*.sql
*.sql.gz
*.dump
*.bak

# ---- Uploaded child photos and other private storage ----
# (already ignored by backend/storage/**/.gitignore; repeated here as a guard)
backend/storage/app/private/*
!backend/storage/app/private/.gitignore
backend/storage/app/public/*
!backend/storage/app/public/.gitignore

# ---- Logs, caches, and test output ----
*.log
coverage/
.phpunit.cache/
.phpunit.result.cache
.eslintcache
*.tsbuildinfo

# ---- Build artifacts ----
*.apk
*.aab
*.ipa

# ---- Dependencies ----
node_modules/
vendor/

# ---- IDE / editor (machine-specific) ----
.idea/
*.iml
.fleet/
.zed/
*.swp
*.swo
*~

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ---- AI assistant local files (CLAUDE.md itself is shared and committed) ----
.claude/settings.local.json
CLAUDE.local.md
prompts.txt
